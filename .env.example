# Copy this file to .env only if you do not already have one; replace all CHANGE_THIS values.
# Use a SQL Server-compatible password: at least 8 characters with uppercase,
# lowercase, a number, and a symbol. Avoid semicolons and dollar signs.
MSSQL_SA_PASSWORD=CHANGE_THIS_LocalOnly_123!

# Generate a random secret of at least 32 bytes. Keep it private.
JWT_SIGNING_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Generate a separate random secret of at least 32 bytes for ClaimsService-to-ClientsService calls.
CLIENTS_SERVICE_API_KEY=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Local development bootstrap administrator only.
ADMIN_BOOTSTRAP_USERNAME=claim-admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_THIS_AdminPassword_123!

# Local host ports (change if a port is already in use).
SQL_PORT=1433
API_PORT=5000
FRONTEND_PORT=8082

# Replace with your Docker Hub username only when you choose to push the image.
DOCKERHUB_USERNAME=your-dockerhub-username
FRONTEND_IMAGE_TAG=local
